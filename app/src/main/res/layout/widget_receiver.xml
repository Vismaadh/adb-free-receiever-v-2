<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:gravity="center">

    <!-- Keep the launcher/background surface at the same size. -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:padding="0dp"
        android:scaleType="fitXY"
        android:background="@drawable/widget_receiver_off"
        android:contentDescription="Receiver background" />

    <!-- Larger receiver glyph, without changing the 1x1 widget surface. -->
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:padding="0dp"
        android:scaleType="centerInside"
        android:src="@drawable/widget_receiver_off_icon"
        android:contentDescription="Receiver is OFF. Tap to turn it on." />
</FrameLayout>
