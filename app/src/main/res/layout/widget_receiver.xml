<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="0dp">

    <LinearLayout
        android:id="@+id/widget_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="center">

        <FrameLayout
            android:id="@+id/widget_tile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_receiver_off"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/receiver_glyph_exact"
                android:contentDescription="Receiver" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="64dp"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/widget_receiver_label"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:singleLine="true" />
    </LinearLayout>
</FrameLayout>
