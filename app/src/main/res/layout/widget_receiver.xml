<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="64dp"
    android:layout_height="68dp"
    android:gravity="top|center_horizontal"
    android:padding="0dp">

    <!-- MIUI-Torch-style 1x1 tile. The label is part of the widget view,
         while targetCellHeight remains 1 so the launcher still allocates one cell. -->
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:background="@drawable/widget_receiver_off"
        android:src="@drawable/widget_receiver_off_icon"
        android:contentDescription="Receiver is OFF. Tap to turn it on." />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="49dp"
        android:gravity="center"
        android:text="@string/widget_receiver_label"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans"
        android:singleLine="true" />
</FrameLayout>
